---
/**
 * The family-feedback band, straight from the testimonial boards: a soft sage
 * panel, the quote set large, and the photograph held inside the Heartwell
 * heart — the same silhouette the layered mark is cut from.
 */
---

  <section class="tband">
    <div class="wrap">
      <div class="tband-panel reveal">
        <svg class="hcontour hc-bl" viewBox="157.6 139.7 936.4 949.4" aria-hidden="true"><use href="#mark"/></svg>
        <div class="tband-quote">
          <blockquote>&ldquo;My mother would be cared for here. And these people know what they&rsquo;re doing.&rdquo;</blockquote>
          <cite>The feeling every Heartwell community should give you in the first five seconds.</cite>
        </div>
        <div class="tband-photo heart-stack">
          <img class="photo-heart" src="/img/lobby.jpg" alt="A bright Heartwell lobby with warm wood, greenery, and the Heartwell heart mark etched in glass" loading="lazy">
        </div>
      </div>
    </div>
  </section>
