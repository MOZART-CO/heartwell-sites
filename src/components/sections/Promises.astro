---
import LayeredHeart from '../LayeredHeart.astro';
import { site } from '../../config/site';
---

  <section class="promises" id="families">
    <div class="wrap prom-grid">
      <div class="prom sage reveal">
        <LayeredHeart tone="dark" />
        <div>
          <h3>We answer the phone.</h3>
          <p>We know your loved one by name. We call you with updates before you need to ask. You will always know how they are doing.</p>
          <a href={`mailto:${site.email}`}>Talk to us about a loved one</a>
        </div>
      </div>
      <div class="prom gold reveal" id="partners">
        <LayeredHeart tone="dark" />
        <div>
          <h3>A trusted partner for complex care.</h3>
          <p>We welcome clinically complex referrals. We respond quickly, we communicate clearly, and we give every new resident expert care from the first day.</p>
          <a href={`mailto:${site.email}`}>Refer or transfer a resident</a>
        </div>
      </div>
    </div>
  </section>
