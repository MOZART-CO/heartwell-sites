---
import SectionHeart from '../SectionHeart.astro';
---

  <section class="manifesto" id="why">
    <svg class="hcontour hc-tr" viewBox="157.6 139.7 936.4 949.4" aria-hidden="true"><use href="#mark"/></svg>
    <div class="wrap">
      <div class="manifesto-grid">
        <div>
          <SectionHeart tone="gold" class="reveal" />
          <h2 class="h-section reveal">Led by people who know every hallway. <span class="h-em">That is the Heartwell difference.</span></h2>
          <p class="lead reveal">Our leaders are licensed administrators who spent their careers inside skilled nursing communities. They lead the same way today: present, hands-on, and close to residents and staff.</p>
        </div>
        <div class="manifesto-photo reveal">
          <img src="/img/hands-held.jpg" alt="A caregiver's steady hand on a resident's arm during an activity" loading="lazy">
        </div>
      </div>
      <div class="pillars">
        <div class="pillar reveal">
          <h3>Present every day</h3>
          <p>Our leaders work in the buildings, week after week, with staff and residents.</p>
        </div>
        <div class="pillar reveal">
          <h3>Clinically strong</h3>
          <p>Clean surveys and high clinical standards, in every community.</p>
        </div>
        <div class="pillar reveal">
          <h3>True to our word</h3>
          <p>We arrive with a clear plan, and we promise only what we can deliver.</p>
        </div>
      </div>
    </div>
  </section>
