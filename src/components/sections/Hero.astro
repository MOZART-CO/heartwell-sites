---
import HeroMark from '../HeroMark.astro';
import { communities } from '../../config/site';

const count = communities.length;
const WORDS: Record<number, string> = { 1: 'One', 2: 'Two', 3: 'Three', 4: 'Four', 5: 'Five' };
const countWord = WORDS[count] ?? String(count);
const cities = [...new Set(communities.map((c) => c.city))];
---

<section class="hero" id="top">
  <svg class="hcontour hc-tr" viewBox="157.6 139.7 936.4 949.4" aria-hidden="true"><use href="#mark"/></svg>
  <div class="wrap hero-inner">
    <div>
      <h1 class="h-display">
        <span class="w reveal-hero" data-h="1">Warm<span class="dot">.</span></span>
        <span class="w reveal-hero" data-h="2">Skilled<span class="dot">.</span></span>
        <span class="w reveal-hero" data-h="3">Present<span class="dot">.</span></span>
      </h1>
      <p class="lead reveal-hero" data-h="4">An operator-led healthcare company. {countWord} {count === 1 ? 'community' : 'communities'} across {cities.length === 1 ? cities[0] + ', ' : ''}Ohio, run by people who have spent their careers on the floor.</p>
      <div class="hero-ctas reveal-hero" data-h="5">
        <a class="btn gold" href="#communities">Explore our communities</a>
        <a class="btn ghost" href="#families">Partner with us</a>
      </div>
    </div>
    <HeroMark />
  </div>
  <div class="wrap">
    <figure class="hero-plate reveal-hero" data-h="5">
      <img src="/img/hero.jpg" alt="A caregiver walking with a resident through a sunlit field at golden hour" loading="eager" fetchpriority="high">
    </figure>
  </div>
</section>
