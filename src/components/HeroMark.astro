---
/**
 * The hub hero's heart: the layered paper-cut heart from the approved boards,
 * stepping through the sage scale to a deep core. Layers settle in once on
 * load, then the whole heart is set breathing — the CSS keys off
 * `.animate` / `.breathing`, exactly as the original ring mark did.
 */
import LayeredHeart from './LayeredHeart.astro';
---

<div class="hero-mark" id="heroMark" aria-hidden="true">
  <LayeredHeart tone="sage" />
</div>

<script>
  const heroMark = document.getElementById('heroMark');
  if (heroMark) {
    heroMark.classList.add('animate');
    setTimeout(() => heroMark.classList.add('breathing'), 2200);
  }
</script>
