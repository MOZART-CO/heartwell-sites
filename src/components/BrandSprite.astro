---
/**
 * The brand marks for the active site, as an inline SVG sprite. Every
 * `<use href="#mark">`, `<use href="#wordmark">` and `<use href="#lockup">` on
 * the page resolves against this — it has to be in the document, so it lives in
 * the shared layout rather than in a file under /img.
 *
 * `#mark` — the five-ring heart. Shared by every Heartwell site.
 * `#wordmark` — "Heartwell" on the hub; the building's own wordmark on a
 *   community site. Used at display size in the footer.
 * `#lockup` — the building's full horizontal lockup (heart + name +
 *   descriptor), on community sites only. This is the nav and footer brand.
 *
 * The per-community artwork is prepared in `src/lib/brand.ts`.
 */
import { lockup, wordmark } from '../lib/brand';
import { HEART_CLIP_TRANSFORM, HEART_PATH } from '../lib/heart';
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <clipPath id="heart-clip" clipPathUnits="objectBoundingBox">
      <path d={HEART_PATH} transform={HEART_CLIP_TRANSFORM} />
    </clipPath>
